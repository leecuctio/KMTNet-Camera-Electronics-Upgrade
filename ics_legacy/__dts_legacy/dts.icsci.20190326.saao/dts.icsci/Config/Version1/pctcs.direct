#
# PCTCS Agent runtime config file
#
# Note that while mixed cases are used for readability, entries
# are case insensitive *EXCEPT* for network hostnames or Unix
# filenames.  Beware!
#
# R. Pogge, OSU Astronomy Dept.
# pogge@astronomy.ohio-state.edu
# 2013 Mar 29
#
###########################################################################

# Application Mode: either STANDALONE or ISISclient

#Mode Standalone
Mode ISISclient

# ISIS Server Info - only releveant if Mode=ISISclient

ISISID   None
ISISHost localhost
ISISPort 6600

# PCTCS Agent's ISIS client info (Host=localhost is implicit)

ID   TC
Port 10801

#
# PC-TCS serial port info
#
# NB: This port must be user read/write enabled by root!
#

TCSPort /dev/ttyS0

# Port timeout and idle time intervals (in seconds)

TIMEOUT  10
IDLETIME 10

# PCTCS Agent client application runtime flags

SIMMODE
VERBOSE
#nolog
#debug
