#!/bin/bash
#
#-- Prepares system resources required for KMTN data acquisition
#
#- JAM, April 15, 2013
#
# June 14. 2013: Changed folder locations, commented out tasks that will not persist through acquisition system startup. Added socat command.
# Sept. 20, 2013: Adding new formatted ramdisk for DOS system logs

#-- Write disk headers to ramdisks
dd if=/home/dts/VMFolder/datadisklabels/disklabel.txt of=/dev/ram0 count=1 bs=512
dd if=/home/dts/VMFolder/datadisklabels/disklabel2.txt of=/dev/ram1 count=1 bs=512

#-- Open permissions to serial port used by ISIS
chmod 777 /dev/ttyS1

#-- Add socat session that allows IC in VM to talk to ISIS
socat pty,link=/home/dts/VMFolder/socat/pty/ICLink,user=root,group=root,cr pty,link=/home/dts/VMFolder/socat/pty/ISISLink,user=dts,group=dts,cr &
#socat pty,link=/home/dts/VMFolder/socat/pty/ICLink,cr pty,link=/home/dts/VMFolder/socat/pty/ISISLink,user=dts,group=dts,cr,reuseaddr &
#socat pty,link=/home/dts/VMFolder/socat/pty/ICLink,cr pty,link=/home/dts/VMFolder/socat/pty/ISISLink,user=dts,group=dts,cr &

#-- Automount the data directory on electron
mount 172.16.3.44:/home/data /mnt/electrondata

#-- Format the last ramdisk

#-- Start the virtual machine
# virsh create /etc/libvirt/qemu/IC3.xml

