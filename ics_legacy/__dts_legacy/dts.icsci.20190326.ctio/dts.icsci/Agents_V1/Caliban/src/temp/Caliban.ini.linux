# Caliban Initialization File
LOG_FILE_NAME Caliban.log
SERIAL_PORT /dev/ttyS1
BLOCK_SIZE 512
VERBOSE
# DEBUG
SERIAL_HOST WC
LOCAL_HOST CB
MAX_XFER_FILES 150
# DOARCHIVE
# DODISPLAY
# DOAUTOLOG
# ADDFITS
SPOOL_DEVICE /dev/sga
