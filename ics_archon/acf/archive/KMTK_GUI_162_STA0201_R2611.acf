MOD10\VCPU_LINE0="StatusPort = 0x0001"
MOD10\VCPU_LINE1="TxEmpty = 1"
MOD10\VCPU_LINE10=ALIAS r5 Count
MOD10\VCPU_LINE100=Sleep100ms:
MOD10\VCPU_LINE101="LOAD r2, 100"
MOD10\VCPU_LINE102=
MOD10\VCPU_LINE103=BigSleepLoop:
MOD10\VCPU_LINE104=CALL Sleep1ms
MOD10\VCPU_LINE105="SUB r2, 1"
MOD10\VCPU_LINE106=IF NZ GOTO BigSleepLoop
MOD10\VCPU_LINE107=RETURN
MOD10\VCPU_LINE11=
MOD10\VCPU_LINE12=Start:
MOD10\VCPU_LINE13="; MKS 356 operates at 9600 baud"
MOD10\VCPU_LINE14="LOAD r0, 0x0800"
MOD10\VCPU_LINE15="OUTPUT r0, 11"
MOD10\VCPU_LINE16="; DIO1 = TX Enable, DIO2 = TX, DIO8 = RX"
MOD10\VCPU_LINE17="LOAD r0, 0x2000"
MOD10\VCPU_LINE18="OUTPUT r0, 0x8097"
MOD10\VCPU_LINE19="OUTPUT r0, 0x0097"
MOD10\VCPU_LINE2="TxFull = 2"
MOD10\VCPU_LINE20="LOAD Alive, 0"
MOD10\VCPU_LINE21=
MOD10\VCPU_LINE22=MainLoop:
MOD10\VCPU_LINE23="; Flush buffer"
MOD10\VCPU_LINE24="LOAD Count, 16"
MOD10\VCPU_LINE25=FlushLoop:
MOD10\VCPU_LINE26="INPUT r0, RxPort"
MOD10\VCPU_LINE27="SUB Count, 1"
MOD10\VCPU_LINE28=IF NZ GOTO FlushLoop
MOD10\VCPU_LINE29="; Switch to transmit"
MOD10\VCPU_LINE3="RxEmpty = 4"
MOD10\VCPU_LINE30="LOAD r0, 0x0101"
MOD10\VCPU_LINE31="OUTPUT r0, 1"
MOD10\VCPU_LINE32="; Query pressure"
MOD10\VCPU_LINE33="LOAD r0, '#'"
MOD10\VCPU_LINE34=CALL Transmit
MOD10\VCPU_LINE35="LOAD r0, '0'"
MOD10\VCPU_LINE36=CALL Transmit
MOD10\VCPU_LINE37="LOAD r0, '5'"
MOD10\VCPU_LINE38=CALL Transmit
MOD10\VCPU_LINE39="LOAD r0, 'R'"
MOD10\VCPU_LINE4="RxFull = 8"
MOD10\VCPU_LINE40=CALL Transmit
MOD10\VCPU_LINE41="LOAD r0, 'D'"
MOD10\VCPU_LINE42=CALL Transmit
MOD10\VCPU_LINE43="LOAD r0, 13"
MOD10\VCPU_LINE44=CALL Transmit
MOD10\VCPU_LINE45=CALL Sleep10ms
MOD10\VCPU_LINE46="; Switch to receive"
MOD10\VCPU_LINE47="LOAD r0, 0x0101"
MOD10\VCPU_LINE48="OUTPUT r0, 0"
MOD10\VCPU_LINE49="; Receive response"
MOD10\VCPU_LINE5="TxPort = 0x1000"
MOD10\VCPU_LINE50=CALL Sleep100ms
MOD10\VCPU_LINE51="LOAD Port, RegPort"
MOD10\VCPU_LINE52="; Skip command"
MOD10\VCPU_LINE53="LOAD Count, 9"
MOD10\VCPU_LINE54=SkipLoop:
MOD10\VCPU_LINE55=CALL Receive
MOD10\VCPU_LINE56=IF C GOTO MainLoop
MOD10\VCPU_LINE57="SUB Count, 1"
MOD10\VCPU_LINE58=IF NZ GOTO SkipLoop
MOD10\VCPU_LINE59="; Store vac pressure reply"
MOD10\VCPU_LINE6="RxPort = 0x0002"
MOD10\VCPU_LINE60="LOAD Count, 10"
MOD10\VCPU_LINE61=StoreLoop:
MOD10\VCPU_LINE62=CALL Receive
MOD10\VCPU_LINE63=IF C GOTO MainLoop
MOD10\VCPU_LINE64="OUTPUT Port, r0"
MOD10\VCPU_LINE65="ADD Port, 1"
MOD10\VCPU_LINE66="SUB Count, 1"
MOD10\VCPU_LINE67=IF NZ GOTO StoreLoop
MOD10\VCPU_LINE68="LOAD Port, 0x020F"
MOD10\VCPU_LINE69="ADD Alive, 1"
MOD10\VCPU_LINE7="RegPort = 0x0200"
MOD10\VCPU_LINE70="OUTPUT Port, Alive"
MOD10\VCPU_LINE71=GOTO MainLoop
MOD10\VCPU_LINE72=
MOD10\VCPU_LINE73=Transmit:
MOD10\VCPU_LINE74="INPUT r1, StatusPort"
MOD10\VCPU_LINE75="TEST r1, TxFull"
MOD10\VCPU_LINE76=IF NZ GOTO Transmit
MOD10\VCPU_LINE77="LOAD r1, TxPort"
MOD10\VCPU_LINE78="OUTPUT r1, r0"
MOD10\VCPU_LINE79=RETURN
MOD10\VCPU_LINE8=ALIAS r3 Port
MOD10\VCPU_LINE80=
MOD10\VCPU_LINE81=Receive:
MOD10\VCPU_LINE82="INPUT r1, StatusPort"
MOD10\VCPU_LINE83="TEST r1, RxEmpty"
MOD10\VCPU_LINE84=IF NZ SETCY
MOD10\VCPU_LINE85=IF Z CLEARCY
MOD10\VCPU_LINE86="INPUT r0, RxPort"
MOD10\VCPU_LINE87=RETURN
MOD10\VCPU_LINE88=
MOD10\VCPU_LINE89=Sleep1ms:
MOD10\VCPU_LINE9=ALIAS r4 Alive
MOD10\VCPU_LINE90="LOAD r1, 49999"
MOD10\VCPU_LINE91=SleepLoop:
MOD10\VCPU_LINE92="SUB r1, 1"
MOD10\VCPU_LINE93=IF NZ GOTO SleepLoop
MOD10\VCPU_LINE94=RETURN
MOD10\VCPU_LINE95=
MOD10\VCPU_LINE96=Sleep10ms:
MOD10\VCPU_LINE97="LOAD r2, 10"
MOD10\VCPU_LINE98=GOTO BigSleepLoop
MOD10\VCPU_LINE99=
MOD10\VCPU_LINES=108
