# macOS / editor noise
.DS_Store
*.swp
*.swo
*~

# Python cache / local runtime
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Large FITS data products are managed outside Git.
*.fits
*.fits.gz
*.fit
*.fit.gz
*.fts
*.fts.gz

# Generated conversion sidecars
*.fits.summary.txt
*.fits.gz.sha256.txt
*.fit.summary.txt
*.fit.gz.sha256.txt
*.fts.summary.txt
*.fts.gz.sha256.txt

# Generated release archives
*.zip
*.zip.sha256.txt

# Local data directories (inputs/samples and pipeline products; managed outside Git)
raw/
mef_pipeline_out/
icsdata/

# ics_sim runtime state: the persisted EXPNUM counter ([paths] expnum_file,
# DevNote 11.12). On the bench it lives next to ~/AIC/Config/ics_sim.ini, but
# running without -c puts it beside the repo ini -- that copy is local state.
*.expnum

# Temporary outputs
*.tmp
*.part
*.log
test.*

~$*.docx
*.lnk
*.bak

# Temporary review round-trip folders: created per review cycle, deleted after.
# Finished deliverables land in the sub-repo root; history stays out of Git.
__review/
